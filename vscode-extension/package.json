{
  "name": "autosoup-vscode",
  "displayName": "AutoSOUP",
  "description": "Generate AutoSOUP unit proofs from VS Code.",
  "version": "0.1.0",
  "publisher": "ampaschal",
  "icon": "resources/icons/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmPaschal/AutoUP.git"
  },
  "homepage": "https://github.com/AmPaschal/AutoUP/blob/main/vscode-extension/README.md",
  "bugs": {
    "url": "https://github.com/AmPaschal/AutoUP/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Testing",
    "AI",
    "Other"
  ],
  "keywords": [
    "cbmc",
    "formal-verification",
    "memory-safety",
    "unit-proof",
    "c"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "autosoup.createUnitProof",
        "title": "Create Unit Proof",
        "category": "AutoSOUP"
      },
      {
        "command": "autosoup.cancelProof",
        "title": "Cancel Unit Proof",
        "category": "AutoSOUP",
        "icon": {
          "light": "resources/icons/cancel.svg",
          "dark": "resources/icons/cancel.svg"
        }
      },
      {
        "command": "autosoup.deleteProof",
        "title": "Delete Unit Proof",
        "category": "AutoSOUP",
        "icon": {
          "light": "resources/icons/delete.svg",
          "dark": "resources/icons/delete.svg"
        }
      },
      {
        "command": "autosoup.openHarness",
        "title": "Open Harness File",
        "category": "AutoSOUP"
      },
      {
        "command": "autosoup.openMakefile",
        "title": "Open Makefile",
        "category": "AutoSOUP"
      },
      {
        "command": "autosoup.openSourceFile",
        "title": "Open Source File",
        "category": "AutoSOUP"
      },
      {
        "command": "autosoup.openLog",
        "title": "Open AutoSOUP Log",
        "category": "AutoSOUP"
      },
      {
        "command": "autosoup.openReport",
        "title": "Open Verification Report",
        "category": "AutoSOUP"
      },
      {
        "command": "autosoup.openVulnerabilityReport",
        "title": "Open Vulnerability Report",
        "category": "AutoSOUP"
      },
      {
        "command": "autosoup.revealProofFolder",
        "title": "Reveal Proof Folder",
        "category": "AutoSOUP"
      },
      {
        "command": "autosoup.refreshProofs",
        "title": "Refresh Unit Proofs",
        "category": "AutoSOUP"
      },
      {
        "command": "autosoup.manageProviderEnvironmentVariables",
        "title": "Manage Provider Environment Variables",
        "category": "AutoSOUP"
      },
      {
        "command": "autosoup.showProofOutput",
        "title": "Show Proof Output",
        "category": "AutoSOUP"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "autosoup.createUnitProof",
          "when": "isWorkspaceTrusted && (resourceLangId == c || resourceLangId == cpp)",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "autosoup.refreshProofs",
          "when": "view == autosoup.proofExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "autosoup.cancelProof",
          "when": "view == autosoup.proofExplorer && viewItem == proofJobCancellable",
          "group": "inline@1"
        },
        {
          "command": "autosoup.deleteProof",
          "when": "view == autosoup.proofExplorer && viewItem == proofJobDeletable",
          "group": "inline@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autosoup-panel",
          "title": "AutoSOUP",
          "icon": "resources/icons/autosoup.svg"
        }
      ]
    },
    "views": {
      "autosoup-panel": [
        {
          "id": "autosoup.proofExplorer",
          "name": "Unit Proofs"
        }
      ]
    },
    "configuration": {
      "title": "AutoSOUP",
      "properties": {
        "autosoup.modelProfiles": {
          "type": "array",
          "default": [],
          "description": "Configured AutoSOUP model profiles. Each profile should be a JSON object with the following fields: name, provider, modelName, and envVars.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "provider",
              "modelName",
              "envVars"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique profile name used by autosoup.selectedModelProfile."
              },
              "provider": {
                "type": "string",
                "description": "Provider label for user reference."
              },
              "modelName": {
                "type": "string",
                "description": "LiteLLM model identifier passed to AutoSOUP."
              },
              "envVars": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Environment variables that must be present in VS Code SecretStorage before proof launch."
              }
            }
          }
        },
        "autosoup.selectedModelProfile": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Name of the AutoSOUP model profile to use for proof generation."
        },
        "autosoup.containerEngine": {
          "type": "string",
          "enum": [
            "auto",
            "docker",
            "apptainer"
          ],
          "default": "auto",
          "description": "Container engine to use for proof execution."
        },
        "autosoup.scopeBound": {
          "type": [
            "integer",
            "null"
          ],
          "default": 1,
          "description": "Scope widening depth bound. The default of 1 disables widening while still enabling scope-reducer behavior."
        },
        "autosoup.scopeTimeBudget": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Optional scope widening time budget in minutes."
        },
        "autosoup.scopeReducerAttempts": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "description": "Maximum number of scope reducer attempts before giving up."
        },
        "autosoup.makeTimeout": {
          "type": "integer",
          "default": 900,
          "minimum": 1,
          "description": "Full verification make timeout in seconds passed to AutoSOUP."
        },
        "autosoup.maxConcurrentJobs": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "description": "Maximum number of AutoSOUP proof jobs that may run at once."
        },
        "autosoup.proofsRoot": {
          "type": "string",
          "default": "cbmc/proofs",
          "description": "Workspace-relative root directory where generated proofs are stored."
        }
      }
    }
  },
  "scripts": {
    "sync-backend": "node ./scripts/sync-backend-assets.js",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run sync-backend && tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node ./test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.0",
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.95.0",
    "mocha": "^11.1.0",
    "typescript": "^5.7.2"
  }
}
